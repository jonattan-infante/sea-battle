# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local agent/tooling artifacts
.playwright-mcp/
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# build del servidor y artefactos de harness
/dist
/.next-e2e/
/qa-artifacts
/test-results
/playwright-report

# sesión del usuario de prueba del arnés remoto (playwright.remote.config.ts)
/.auth
